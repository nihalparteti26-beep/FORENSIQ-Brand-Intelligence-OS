# =================================================================
# FORENSIQ BRAND INTELLIGENCE OS — ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and configure with your service credentials.
# If external service credentials are omitted, FORENSIQ automatically
# activates its zero-configuration durable local persistence engines:
#   - Neo4j: Falls back to data/neo4j_store.json (atomic ACID JSON graph)
#   - Qdrant: Falls back to data/qdrant_store.json (deterministic 384-dim semantic vector search)
#   - OpenAI: Falls back to local deterministic AST & NLP claim extractor
#   - Unstructured: Falls back to local pdf-parse & xlsx spreadsheet parser
# =================================================================

# Server Port
PORT=3001
NODE_ENV=production

# -----------------------------------------------------------------
# 1. NEO4J KNOWLEDGE GRAPH CONFIGURATION
# -----------------------------------------------------------------
# For Neo4j AuraDB or Self-Hosted Neo4j 5.x+
# Example URI: neo4j+s://your-instance-id.databases.neo4j.io:7687
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# -----------------------------------------------------------------
# 2. QDRANT VECTOR DATABASE CONFIGURATION
# -----------------------------------------------------------------
# For Qdrant Cloud or Self-Hosted Qdrant
# Example URL: https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# -----------------------------------------------------------------
# 3. OPENAI VISION & LANGUAGE MODEL CONFIGURATION
# -----------------------------------------------------------------
# Configurable LLM for Vision Guard & unstructured claim extraction
# Supported models: gpt-4o, gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------
# 4. UNSTRUCTURED.IO DOCUMENT PARSER (OPTIONAL)
# -----------------------------------------------------------------
# For Unstructured Serverless API
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_URL=https://api.unstructuredapp.io/general/v0/general

# -----------------------------------------------------------------
# 5. BRAND STANDARDS CONFIGURATION
# -----------------------------------------------------------------
BRAND_PRIMARY_HEX=#0A4D8C
BRAND_NAME=Inkloom
